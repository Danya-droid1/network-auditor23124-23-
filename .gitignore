# -*- coding: utf-8 -*-
# Файл исключений для Git.
# Указывает, какие файлы и папки не должны попадать в репозиторий.
# Автор: Голуб Д.Н., группа о.ИЗДтс 23.1/Б4-23

# === Скомпилированные Python-файлы ===
__pycache__/
*.py[cod]
*$py.class
*.so

# === Виртуальные окружения ===
env/
venv/
ENV/
.venv/

# === Директории сборки и дистрибутивов ===
build/
dist/
*.egg-info/
*.egg

# === Файлы установки пакетов ===
.installed.cfg
sdist/
var/
wheels/

# === Файлы тестирования ===
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# === Настройки IDE ===
.idea/
.vscode/
*.swp
*.swo
*~

# === Системные файлы ===
.DS_Store
Thumbs.db

# === Локальные файлы приложения ===
reports/
*.log
*.db
*.sqlite
config.json